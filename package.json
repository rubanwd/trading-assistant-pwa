{
  "name": "trading-assistant-pwa",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.scripts.json",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply trading-assistant --local",
    "db:migrate": "wrangler d1 migrations apply trading-assistant --remote",
    "deploy:ci": "wrangler d1 migrations apply trading-assistant --remote && wrangler deploy",
    "backtest": "tsx scripts/backtest.ts",
    "backtest:tube": "tsx scripts/tube-backtest.ts",
    "backtest:pick": "tsx scripts/pick-backtest.ts",
    "patterns": "tsx scripts/patterns.ts",
    "backtest:channel": "tsx scripts/channel-backtest.ts",
    "backtest:momentum": "tsx scripts/momentum-backtest.ts"
  },
  "dependencies": {
    "@pushforge/builder": "^2.0.5",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
