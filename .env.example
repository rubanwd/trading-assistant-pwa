# Бот пробою 20/10 (npm run b2010). Скопіюйте у .env; .env у git не потрапляє.
# Ключі API лише тут або в оточенні — ні в коді, ні в БД, ні в журналі.

# Капітал, виділений боту (окремий субакаунт або явно виділена сума), USDT
B2010_BALANCE=500
# Плановий ризик на угоду, % капіталу бота
B2010_RISK_PCT=0.5
# Taker-комісія та несприятливе прослизання за одну сторону, %
B2010_TAKER_FEE_PCT=0.055
B2010_SLIPPAGE_PCT=0.05
# Комісія споту для порівняння з купівлею BTC у бектесті, %
B2010_SPOT_FEE_PCT=0.1
# Вікно входу від початку доби UTC, секунд (лише для нових входів)
B2010_ENTRY_WINDOW_SEC=120
# Як часто рушій перевіряє ціну й біржу, мс
B2010_POLL_MS=2000
# Де лежать SQLite, кеш історії та звіти
B2010_DATA_DIR=.b2010

# Testnet (https://testnet.bybit.com): окремі ключі лише з правом торгівлі, без виведення
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# Live: реальні гроші. Потрібні ще B2010_LIVE_ENABLED=yes і прапорець --confirm-live.
# Ключ лише з правом торгівлі деривативами, без виведення, бажано з білим списком IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=
B2010_LIVE_ENABLED=no
