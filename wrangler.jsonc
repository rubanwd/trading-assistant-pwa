{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trading-assistant-pwa",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["*/30 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "ENGINE", "class_name": "Engine" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Engine"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trading-assistant",
      "database_id": "94a23689-2a6c-482a-8cec-db11d4e5abd9",
      "migrations_dir": "migrations"
    }
  ],
  // Змінні задаються в панелі Cloudflare (Worker → Settings → Variables and Secrets) і не затираються деплоєм:
  //   ACCESS_TEAM_DOMAIN  домен команди Access, наприклад myteam.cloudflareaccess.com
  //   ACCESS_AUD          тег AUD застосунку Access; без цих двох API відповідає 401
  //   APP_ORIGIN          адреса застосунку для посилань у Telegram
  //   VAPID_PUBLIC_KEY    публічний ключ Web Push; застосунок уміє згенерувати пару ключів сам
  //   VAPID_SUBJECT       контакт для сервісів push: mailto:…
  // Секрети: OPENROUTER_API_KEY, VAPID_PRIVATE_KEY, за бажанням TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, COINGECKO_API_KEY.
  "keep_vars": true,
  "observability": { "enabled": true }
}
